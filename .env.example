# Copie para .env (o .env nunca vai para o git).
# Chave própria da YouTube Data API v3 para "Abrir jogos ao vivo do YouTube" (opcional:
# o instalador oficial já traz a chave do projeto; esta tem prioridade sobre ela).
QUADRA_YOUTUBE_API_KEY=

# Conta EVS da Castlabs (assinatura VMP do release). Só para você lembrar dos dados:
# nem o app nem o build leem estes campos. O cliente castlabs-evs guarda os tokens em
# ~/.config/evs/config.json, e é o conteúdo desse arquivo que vai no secret EVS_AUTH_JSON.
EVS_ACCOUNT_NAME=
EVS_ACCOUNT_PASSWORD=
EVS_ACCOUNT_EMAIL=
